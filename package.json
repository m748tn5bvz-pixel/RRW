{
  "name": "road-rash-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Motor web (Three.js) que lee los datos de una instalación de Road Rash (1996) del usuario. No incluye ni distribuye datos del juego.",
  "scripts": {
    "import": "node importer/import.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
